{
  "name": "lever-master",
  "version": "2.9.2",
  "description": "てこマスター - 小6理科「てこのはたらき」を遊びながら学ぶ教材ゲーム",
  "type": "module",
  "scripts": {
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm test",
    "vendor": "node scripts/vendor.mjs",
    "build:gas": "node scripts/build-gas.mjs",
    "push:gas": "npm run build:gas && clasp push -f",
    "deploy:gas": "npm run push:gas && clasp redeploy $npm_package_config_gasDeploymentId --description \"sync from src\"",
    "deploy": "git push && echo \"GitHub Pages の反映後に npm run deploy:gas を実行してください\""
  },
  "keywords": [
    "education",
    "science",
    "lever",
    "game",
    "pwa"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@fontsource/orbitron": "^5.3.0",
    "esbuild": "^0.27.1",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "three": "^0.186.1",
    "vitest": "^4.0.15"
  },
  "config": {
    "gasDeploymentId": "AKfycbz_PW1DWZy3svW9yOus-wvuN4et-666Ees99J3Kgjj7ZYxv0VSwGxcl0rVJzriNsR6i6w"
  },
  "engines": {
    "node": ">=20.12"
  }
}
